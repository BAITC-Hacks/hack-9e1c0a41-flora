# Для агента и локальной панели переменные окружения не требуются.
# OPENAI_API_KEY используется только необязательным ассистентом панели по кнопке.
# Agent.act() и генератор submission не используют ключ и не вызывают LLM.
# Не коммитьте реальные значения. Файл .env автоматически не загружается.
OPENAI_API_KEY=
# Необязательная модель ассистента панели:
OPENAI_MODEL=gpt-4.1-mini
# Необязательный путь к отчёту; по умолчанию docs/RESULTS.md внутри репозитория.
# FLORA_RESULTS_PATH=
